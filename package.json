{
  "name": "poc-bun-fastify",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "migration:generate": "bun src/db/migration-generate.ts",
    "migrate:up": "bun src/db/migrate-up.ts",
    "migrate:down": "bun src/db/migrate-down.ts",
    "migrate:fresh": "bun src/db/migrate-fresh.ts"
  },
  "dependencies": {
    "amqplib": "^2.2.0",
    "drizzle-orm": "^0.45.4",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
